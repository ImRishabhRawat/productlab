MONGODB_URI=mongodb://127.0.0.1:27017/product-lab
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

PORT=4000
SESSION_DAYS=7
# COOKIE_SECURE=true
# TRUST_PROXY=1

# Optional. Enables AI analysis; only the backend reads it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional. Enables push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# SCHEDULER=off
